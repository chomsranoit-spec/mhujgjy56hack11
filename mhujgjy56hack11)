Particle.MouseButton1Click:Connect(function()
	if particleRunning then
		particleRunning=false
		for _,e in pairs(emitters) do if e then e:Destroy() end end
		emitters={}
		Particle.Text="PARTICLES"
	else
		particleRunning=true
		Particle.Text="STOP PARTICLES"
		local function apply(ply)
			task.wait(0.1)
			if not ply.Character then return end
			local hrp = ply.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local e = Instance.new("ParticleEmitter")
			e.Texture = MyCustomID
			e.Rate = 250
			e.Lifetime = NumberRange.new(0.4, 1.5)
			e.Speed = NumberRange.new(8, 20)
			e.SpreadAngle = Vector2.new(60, 60)
			e.Drag = 0.7
			e.Acceleration = Vector3.new(0, 5, 0)
			e.Size = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0.6),
				NumberSequenceKeypoint.new(1, 2.5)
			}
			e.Parent = hrp
			table.insert(emitters, e)
		end
		for _,p in pairs(Players:GetPlayers()) do task.spawn(apply, p) end
		Players.PlayerAdded:Connect(apply)
	end
end)

Disco.MouseButton1Click:Connect(function()
	if discoRunning then
		discoRunning=false
		if discoConn then discoConn:Disconnect() end
		Lighting.Ambient=Color3.fromRGB(128,128,128)
		Lighting.FogColor=Color3.fromRGB(128,128,128)
		Lighting.FogEnd=100000
		Disco.Text="DISCO FOG"
		for _,c in pairs(Lighting:GetChildren()) do
			if c:IsA("ColorCorrectionEffect") then c:Destroy() end
		end
	else
		discoRunning=true
		Disco.Text="STOP DISCO"
		local cc=Instance.new("ColorCorrectionEffect", Lighting)
		local t = 0
		Lighting.TimeOfDay=1200
		Lighting.FogEnd=80
		discoConn=RunService.Heartbeat:Connect(function()
			if not discoRunning then return end
			t=t+0.015
			local r=math.abs(math.sin(t))*255
			local g=math.abs(math.sin(t+2))*255
			local b=math.abs(math.sin(t+4))*255
			cc.TintColor=Color3.fromRGB(r,g,b)
			Lighting.FogColor=Color3.fromRGB(r,g,b)
		end)
	end
end)

